{
  "name": "cloud-store-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Mineflayer cloud warehouse bot for player item deposit and withdrawal.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js test/craft/*.test.js test/path/*.test.js",
    "dashboard": "python inventory-dashboard/dashboard.py",
    "check": "node scripts/check.js && node scripts/check-pathfinder.js",
    "download:lang": "node scripts/download-lang.js",
    "preview:item-render": "node scripts/item-render-preview.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "minecraft-data": "^3.112.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "file:vendor/mineflayer-pathfinder",
    "pinyin-pro": "3.29.5",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.1.10"
  }
}
