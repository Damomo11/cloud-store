{
  // Optional bot account pool. When empty, the legacy server account below is used.
  // Each entry inherits host, port, auth, version and timing-independent server fields.
  "bots": [
    // {
    //   "username": "first-microsoft-email@example.com",
    //   "botName": "WarehouseBot1",
    //   "profilesFolder": "auth-cache/bot-1"
    // },
    // {
    //   "username": "second-microsoft-email@example.com",
    //   "botName": "WarehouseBot2",
    //   "profilesFolder": "auth-cache/bot-2"
    // }
  ],

  // Minecraft server and bot account settings.
  "server": {
    // Server address and port.
    "host": "127.0.0.1",
    "port": 25565,

    // Bot login account. For Microsoft auth, use the account email.
    "username": "your-microsoft-email@example.com",
    "botName": "NanKinz1",

    // Only Microsoft OAuth2 device-code login is supported.
    "auth": "microsoft",

    // Legacy single-account auth cache folder for Microsoft OAuth2 tokens.
    "profilesFolder": "auth-cache",

    // Minecraft protocol version. Cloud store always uses this exact version.
    "version": "1.21.11",

    // Client language sent to the server.
    "locale": "zh_CN"
  },

  // Player names with admin permission.
  "admins": [
    "YourPlayerName"
  ],

  // Internal owner used for unclaimed or extra physical items.
  "momoOwner": "__momo__",

  // Built-in web dashboard.
  "web": {
    // Enable the web dashboard.
    "enabled": true,

    // Bind address. Use "0.0.0.0" to listen on all network interfaces.
    "host": "127.0.0.1",

    // HTTP port for the dashboard.
    "port": 8787,

    // Optional public URL shown in chat and logs.
    // Leave it commented out to auto-generate a local URL from host/port.
    // For reverse proxy or tunnel use, set this to the real public URL.
    // Do not set this to "http://0.0.0.0:8787/" because 0.0.0.0 is only a bind address.
    // "dashboardUrl": "https://your-public-domain.example/",

    // Trust X-Forwarded-For / X-Real-IP headers from a reverse proxy.
    "trustProxy": false,

    // Login brute-force protection.
    "maxLoginFailures": 5,
    "loginFailWindowMs": 600000,
    "loginBlockMs": 600000,

    // Temporary web login code lifetime.
    "loginCodeTtlMs": 120000,

    // Web session lifetime. This is sliding-renewed while the page is in use.
    "sessionTtlMs": 2592000000,
    // Independent Bot Self-Hosting Platform URL. The cloud store only checks it when the user clicks the entry.
    "botPlatformUrl": "http://127.0.0.1:8788",
    // Local HMAC key file. Copy the same key into the Bot platform's configured key file.
    "botPlatformSsoSecretFile": "data/bot-platform-sso.key",
    // Terminal live-log ring buffer shown in the admin panel "运行日志" tab.
    "consoleLogLimit": 5000
  },

  // Storage quota and custom warehouse limits.
  "storage": {
    // Default personal quota in slots. 270 slots = 17280 normal 64-stack items.
    "defaultQuotaSlots": 270,

    // Default custom warehouse quota in slots.
    "defaultCustomWarehouseQuotaSlots": 270,

    // Maximum custom warehouses each player can create.
    "maxCustomWarehousesPerPlayer": 3
  },

  // Server commands used by the bot.
  "commands": {
    // Home command used to return to the warehouse.
    "home": "/home ck",

    // Request teleport to a player.
    "tpa": "/tpa {player}",

    // Accept an admin teleport request.
    "tpaccept": "/tpaccept {player}",

    // Private message command.
    "msg": "/msg {player} {message}",

    // If true, the bot may use public chat when private message fails.
    "publicFallback": false
  },

  // Timing knobs. Increase these if the server is laggy.
  "timing": {
    // Minimum wait after /home before accepting the position as stable.
    "homeWaitMs": 3500,

    // Maximum wait for /home to reach the known warehouse area.
    "homeTimeoutMs": 30000,

    "pickupWindowMs": 10000,
    "depositLeaveDistance": 4,
    "postTeleportWaitMs": 1500,
    "dropIntervalMs": 250,

    // Maximum wait for inventory count to decrease after dropping an item stack.
    "dropConfirmTimeoutMs": 5000,

    // Items are dropped as one batch and confirmed once at the end;
    // this is how many extra rounds are used to re-drop whatever did not leave the inventory.
    "dropConfirmRounds": 3,

    // Container withdrawals click in batches and confirm once per pass;
    // this is how many extra passes are used to re-take whatever did not move.
    "withdrawConfirmPasses": 2,

    // When a withdrawal click gets no server confirmation (uncertain physical state),
    // clear the cursor and retry from the live container state up to this many extra
    // times before skipping the barrel. 0 restores the old fail-fast behavior.
    "withdrawUncertainRetries": 2,

    // The server may occasionally answer a quick shulker open with an empty window;
    // close and reopen up to this many times before skipping the box.
    "quickShulkerOpenAttempts": 3,

    // A barrel that reads as completely empty is usually a lagged empty window,
    // not real missing stock; close and reopen up to this many times before
    // skipping that barrel while keeping its old record.
    "barrelEmptyRereadAttempts": 3,

    // When a barrel holds less of an item than recorded, its record is refreshed
    // in place and the bot moves on to the next recorded barrel; this caps how
    // many short-stocked barrels are chased per item before reporting the rest
    // as missing.
    "withdrawMaxMissingBarrels": 5,

    // When the ledger has stock but no barrel slot records at all, the bot opens
    // registered barrels one by one looking for the item and refreshes each barrel's
    // record from what it actually reads. This caps how many barrels are opened
    // this way. 0 restores the old behavior (fail immediately without searching).
    "withdrawMaxUnlocatedBarrels": 12,

    // Per-barrel wait when searching barrels that have no slot record. The search
    // ends the wait as soon as the container contents arrive; if nothing arrives
    // within this time the barrel is treated as empty and the search moves on.
    "unlocatedBarrelWaitMs": 5000,

    "pickupSettleMs": 3500,
    "pickupStableMs": 700,
    "containerSettleMs": 250,
    "containerClickIntervalMs": 50,
    // Milliseconds to wait for the quick shulker window after right-click
    // activation (also the fallback timeout for container opens).
    "openContainerTimeoutMs": 8000,

    // The server may occasionally drop an open-container request, waiting out the
    // timeout with no window. Retry up to this many attempts in total (first one
    // included); each attempt uses the timeout below, doubling as it goes.
    "openContainerAttempts": 3,
    "openContainerTimeoutsMs": [2000, 4000, 8000],
    "inventoryUpdateTimeoutMs": 2000,
    "pathTimeoutMs": 15000,
    "pathNoProgressMs": 4000,
    "commandDedupeMs": 1500,
    "teleportRequestTimeoutMs": 15000,
    "teleportDetectRadius": 8,
    "reconnectDelayMs": 10000
  },

  // General debug logging.
  "debug": true,

  // Command/chat debug logging.
  "debugChat": true,

  // Raw chat packet logging. Enable only when diagnosing custom chat formats.
  "debugRawChat": false,

  // Withdraw/sync trace log (logs/withdraw-trace-<date>.jsonl). One traceId per
  // withdraw task: what item, which barrel it was located in, window contents after
  // opening, shulker box chain, how much was taken/returned and every decision.
  // Keep the file for the day of a failure and share it to diagnose the failing step.
  "traceLog": {
    "enabled": true,
    "directory": "logs",
    "retentionDays": 14
  },

  // Server resource pack behavior.
  "resourcePack": {
    // Automatically accept forced server resource packs.
    "autoAccept": true
  },

  // Physical warehouse layout and container scanning.
  "warehouse": {
    // Platform default for extracting loose items from quick/openable shulker boxes.
    // Individual warehouses can override this in the admin panel.
    "quickShulkerExtractionEnabled": true,

    // "normal" works for ordinary layouts. "cylinder" enables special stand-position logic.
    "layoutMode": "normal",

    // Default scan radius for !同步仓库.
    "defaultSyncRadius": 16,

    // Item pickup radius when collecting player drops.
    "pickupRadius": 2,

    // If the bot is already near a known barrel, it may skip /home.
    "homeSkipRadius": 8,

    // Maximum allowed scan radius.
    "maxSyncRadius": 64,

    // Stop deposit after trying this many empty candidate barrels.
    "maxEmptyDepositAttempts": 3,

    // Held item ids (without the minecraft: prefix) the bot must not hold when
    // opening a container, e.g. "flint" — it switches hotbar first. Any *_spawn_egg
    // id is always treated as unsafe regardless of this list (right-click spawns
    // a mob instead of opening the container).
    "containerOpenUnsafeHeldItems": ["flint"],

    // Extra settings for cylinder warehouse layouts.
    "cylinder": {
      // Main tunnel axis: "x" or "z".
      "axis": "x",

      // Optional tunnel center. null means auto-detect from the bot's home position.
      "tunnelCenter": {
        "x": null,
        "y": null,
        "z": null
      },

      // Y offsets to try when choosing standing positions.
      "yOffsets": [
        0,
        -1,
        1
      ]
    },

    // Only these block names are treated as warehouse containers.
    "chestBlockNames": [
      "barrel"
    ]
  },

  // Localized language file used for Chinese item names.
  "language": {
    "file": "data/zh_cn.json"
  },

  // Manual item name aliases for items not covered by the built-in registry or
  // the localized language file (vanilla/mod names, e.g. "石头": "modid:custom_stone").
  "aliases": {
  }
}
